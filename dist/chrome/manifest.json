{
  "manifest_version": 3,
  "name": "Cat'sTube2Mp3",
  "version": "1.0.0",
  "description": "Download songs from YouTube playlists as MP3 files.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cat'sTube2Mp3",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
